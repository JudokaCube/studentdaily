def _luminance(hexcode):
    h = hexcode.lstrip("#")
    out = []
    for i in (0, 2, 4):
        v = int(h[i:i + 2], 16) / 255
        out.append(v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4)
    return 0.2126 * out[0] + 0.7152 * out[1] + 0.0722 * out[2]


def _contrast(a, b):
    la, lb = sorted((_luminance(a), _luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def _pick(colours, roles, fallback, minimum):
    bg = colours.get("surface")
    for role in roles:
        value = colours.get(role)
        if not value:
            continue
        try:
            if not bg or _contrast(value, bg) >= minimum:
                return value
        except ValueError:
            continue
    return fallback


def _fg(hexcode):
    h = hexcode.lstrip("#")
    return f"38;2;{int(h[0:2], 16)};{int(h[2:4], 16)};{int(h[4:6], 16)}"


def load_theme():
    global _theme_mtime
    try:
        mtime = os.path.getmtime(SCHEME_FILE)
        with open(SCHEME_FILE) as f:
            colours = json.load(f).get("colours", {})
    except (OSError, ValueError):
        mtime, colours = None, {}
    for name, (roles, fallback, minimum) in THEME_ROLES.items():
        try:
            globals()[name] = _fg(_pick(colours, roles, fallback, minimum))
        except ValueError:
            globals()[name] = _fg(fallback)
    _theme_mtime = mtime


def refresh_theme():
    global _theme_checked
    now = time.monotonic()
    if now - _theme_checked < 1:
        return
    _theme_checked = now
    try:
        mtime = os.path.getmtime(SCHEME_FILE)
    except OSError:
        return
    if mtime != _theme_mtime:
        load_theme()
        if USE_COLOR:
            emit_theme()


def c(code, text):
    if not USE_COLOR:
        return text
    refresh_theme()
    return f"\033[{code}m{text}\033[0m"


load_theme()
BOLD = "1"


def hm(s):
    h, m = s.split(":")
    return int(h) * 60 + int(m)


def fmt_delta(mins):
    if mins < 60:
        return f"{mins}m"
    return f"{mins // 60}h {mins % 60:02d}m"


def fmt_delta_sec(seconds):
    if seconds < 0:
        seconds = 0
    if seconds < 60:
        return f"{seconds}s"
    mins, secs = divmod(seconds, 60)
    if mins < 60:
        return f"{mins}m {secs:02d}s"
    hours, mins = divmod(mins, 60)
    return f"{hours}h {mins:02d}m"


def now_seconds(at):
    if at is not None:
        return at * 60
    n = datetime.now()
    return n.hour * 3600 + n.minute * 60 + n.second


def day_name(dt):
    idx = dt.weekday()
    if idx > 4:
        return None
    return DAYS[idx]


def effective_day(now, hour):
    d = now
    if now.weekday() > 4 or hour >= 16:
        d = now + timedelta(days=1)
        while d.weekday() > 4:
            d += timedelta(days=1)
    return DAYS[d.weekday()]


def resolve_day(arg, today):
    if arg is None:
        return day_name(today) or "monday"
    a = arg.lower()
    if a in ("tomorrow", "tmr", "tom"):
        nxt = today + timedelta(days=1)
        while nxt.weekday() > 4:
            nxt += timedelta(days=1)
        return DAYS[nxt.weekday()]
    for d in DAYS:
        if d.startswith(a):
            return d
    return None


def teacher_of(subject):
    return TEACHERS.get(subject, "")


def render_day(day, now_sec, is_today, note=""):
    rows = TIMETABLE[day]
    now_min = now_sec // 60
    now_idx = None
    next_idx = None
    if is_today:
        for i, (start, end) in enumerate(PERIODS):
            if rows[i] and hm(start) <= now_min < hm(end):
                now_idx = i
            if rows[i] and hm(start) > now_min and next_idx is None:
                next_idx = i

    out = []
    clock = "" if not is_today else c(DIM, datetime.now().strftime("%H:%M:%S"))
    head = c(ACCENT, c(BOLD, day)) + ("  " + clock if clock else "")
    if note:
        head += "  " + c(DIM, note)
    out.append("")
    out.append("  " + head)
    out.append("")

    for i, (start, end) in enumerate(PERIODS):
        cell = rows[i]
        if cell is None:
            line = f"   {start}–{end}   " + c(DIM, "free")
            out.append(line)
            continue
        subject, room = cell
        room_disp = room if room else "–"
        past = is_today and hm(end) <= now_min
        marker = " "
        status = ""
        if i == now_idx:
            marker = c(NOW, "●")
            left = hm(end) * 60 - now_sec
            status = c(NOW, f"now · ends in {fmt_delta_sec(left)}")
        elif i == next_idx:
            marker = c(NEXT, "○")
            left = hm(start) * 60 - now_sec
            status = c(NEXT, f"next · in {fmt_delta_sec(left)}")

        timecol = f"{start}–{end}"
        subjcol = f"{subject:<10}"
        roomcol = c(ROOM, f"{room_disp:<12}") if not past else f"{room_disp:<12}"
        body = f" {marker} {timecol}   {subjcol} {roomcol} {status}".rstrip()
        if past:
            body = c(DIM, f" {marker} {timecol}   {subjcol} {room_disp:<12}").rstrip()
        out.append(body)

    if is_today:
        out.append("")
        if now_idx is not None:
            s, r = rows[now_idx]
            t = teacher_of(s)
            left = hm(PERIODS[now_idx][1]) * 60 - now_sec
            det = " · ".join(
                x for x in [s, t, f"room {r}" if r else "", f"ends in {fmt_delta_sec(left)}"] if x
            )
            out.append("  " + c(NOW, "now  ") + det)
        if next_idx is not None:
            s, r = rows[next_idx]
            t = teacher_of(s)
            left = hm(PERIODS[next_idx][0]) * 60 - now_sec
            det = " · ".join(
                x for x in [s, t, f"room {r}" if r else "", f"in {fmt_delta_sec(left)}"] if x
            )
            out.append("  " + c(NEXT, "next ") + det)
        if now_idx is None and next_idx is None:
            out.append("  " + c(DIM, "done for the day"))
    out.append("")
    return "\n".join(out)


def render_week():
    now = datetime.now()
    today = day_name(now)
    ns = now_seconds(None)
    parts = []
    for d in DAYS:
        parts.append(render_day(d, ns, d == today))
    return "\n".join(parts)


