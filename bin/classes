def atomic_json(path, data):
    import tempfile
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    temp = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=directory, delete=False) as f:
            temp = f.name
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
        os.replace(temp, path)
    finally:
        if temp and os.path.exists(temp):
            os.unlink(temp)


TIMEZONE_FILE = os.path.join(os.path.dirname(CONFIG_FILE), 'timezones.json')
DEFAULT_TIMEZONES = []


def load_timezones():
    try:
        with open(TIMEZONE_FILE) as f:zones=json.load(f)
    except FileNotFoundError:return list(DEFAULT_TIMEZONES)
    if not isinstance(zones,list):raise ValueError('Timezones must be a list')
    for item in zones:
        if not isinstance(item.get('label'),str) or not item['label'].strip():raise ValueError('Timezone label required')
        ZoneInfo(item['zone'])
    return zones


def display_time(value, seconds=False):
    """Format for display only; scheduling and serialized data stay HH:MM."""
    if isinstance(value,str):hour,minute=map(int,value.split(':')[:2]);second=0
    else:hour,minute,second=value.hour,value.minute,value.second
    tail=f':{second:02d}' if seconds else ''
    if nord_theme.options('classes')['classes_time_format']=='12':return f'{hour%12 or 12}:{minute:02d}'+tail+(' AM' if hour<12 else ' PM')
    return f'{hour:02d}:{minute:02d}'+tail


def display_teacher(event):
    return event.get('teacher','') if nord_theme.options('classes')['classes_teacher_details'] else ''


def default_event_end():
    hour,minute=divmod(9*60+nord_theme.options('classes')['classes_default_duration'],60)
    return f'{hour:02d}:{minute:02d}'


def timezone_text(now):
    seconds=nord_theme.options('classes')['classes_clock_seconds']
    local=now.astimezone()
    parts=[f'Local {display_time(local,seconds)} {local:%Z}']
    for item in load_timezones():
        zone=now.astimezone(ZoneInfo(item['zone']))
        parts.append(f"{item['label']} {display_time(zone,seconds)} {zone:%Z}")
    return '   '.join(parts)


def text_dialog(title, value='', hint=''):
    import curses
    def screen(win):
        nonlocal value
        win.keypad(True);curses.curs_set(0);curses.start_color();curses.use_default_colors()
        nord_theme.curses_colors(curses,win)
        while True:
            h,w=win.getmaxyx();win.erase();nord_theme.menu_frame(curses,win)
            for y,text in ((1,title),(3,hint),(5,'› '+value[-max(1,w-7):]),(h-2,'Enter Save · Ctrl+U Clear · Esc Cancel')):
                if 0<=y<h-1:
                    try:win.addnstr(y,2,text,max(0,w-4),curses.color_pair(2 if y==5 else 1))
                    except curses.error:pass
            win.refresh()
            try:key=win.get_wch()
            except curses.error:continue
            if key in ('\x1b','\x03'):return None
            if key in ('\n','\r'):return value.strip()
            if key=='\x15':value=''
            elif key in (curses.KEY_BACKSPACE,'\x7f','\b'):value=value[:-1]
            elif isinstance(key,str) and key.isprintable():value+=key
    return nord_theme.run_screen(screen)


def choose_menu(title, items, hint='', win=None, searchable=False):
    """Visible choices with keyboard, mouse and optional type-to-filter search."""
    import curses
    def screen(window):
        window.keypad(True);curses.curs_set(0)
        curses.start_color();curses.use_default_colors();curses.mousemask(curses.ALL_MOUSE_EVENTS)
        nord_theme.curses_colors(curses,window)
        selected=0;query='';offset=0
        while True:
            visible=[item for item in items if query.casefold() in (' '.join(str(v) for v in item[1:])).casefold()]
            selected=max(0,min(selected,len(visible)-1));h,w=window.getmaxyx();size=max(1,h-10)
            offset=min(offset,selected)
            if selected>=offset+size:offset=selected-size+1
            window.erase();nord_theme.menu_frame(curses,window)
            def put(y,text,style=0):
                if 0<=y<h-1:
                    try:window.addnstr(y,2,text,max(0,w-4),style)
                    except curses.error:pass
            put(1,title,curses.color_pair(1)|curses.A_BOLD)
            put(2,('Search: '+query+' · type to filter') if searchable else hint)
            for i,item in enumerate(visible[offset:offset+size],offset):
                put(4+i-offset,(('› ' if selected==i else '  ')+item[1]).ljust(max(0,w-4)),curses.color_pair(2) if selected==i else 0)
            if not visible:put(4,'No matches. Backspace clears your search.')
            if visible and len(visible[selected])>2:
                import textwrap
                for row,text in enumerate(textwrap.wrap(visible[selected][2],max(1,w-4))[:3]):put(h-5+row,text,curses.color_pair(1))
            put(h-2,'↑↓ Select · Enter Choose · Esc Back'+(' · '+str(len(visible))+' results' if searchable else ''))
            window.refresh()
            try:key=window.get_wch()
            except curses.error:continue
            if key in ('\x1b','\x03'):return None
            if key==curses.KEY_MOUSE:
                try:_,x,y,_,state=curses.getmouse()
                except curses.error:continue
                if state & curses.BUTTON4_PRESSED:key=curses.KEY_UP
                elif state & getattr(curses,'BUTTON5_PRESSED',0):key=curses.KEY_DOWN
                elif state & (curses.BUTTON1_CLICKED|curses.BUTTON1_PRESSED) and 4<=y<4+min(size,len(visible)-offset):selected=offset+y-4;key='\n'
                else:continue
            if key in ('\n','\r') and visible:return visible[selected][0]
            if key in (curses.KEY_UP,curses.KEY_DOWN,'\t'):
                selected=max(0,min(len(visible)-1,selected+(-1 if key==curses.KEY_UP else 1)))
            elif key in (curses.KEY_NPAGE,curses.KEY_PPAGE):selected=max(0,min(len(visible)-1,selected+(size if key==curses.KEY_NPAGE else -size)))
            elif searchable and key in (curses.KEY_BACKSPACE,'\x7f','\b'):query=query[:-1];selected=offset=0
            elif searchable and isinstance(key,str) and key.isprintable():query+=key;selected=offset=0
    if win is not None:return screen(win)
    return nord_theme.run_screen(screen)


def edit_timezones():
    if not sys.stdin.isatty() or not sys.stdout.isatty():return edit_timezones_text()
    from zoneinfo import available_timezones
    while True:
        zones=load_timezones()
        action=choose_menu('STUDENTDAILY / CLOCKS', [('add','+ Add clock')]+[(i,item['label']+' · '+item['zone']) for i,item in enumerate(zones)],'Local time is always shown. Select a clock to change it.')
        if action is None:return
        if action!='add':
            operation=choose_menu(zones[action]['label'],[('change','Change city / timezone'),('rename','Rename clock'),('delete','Remove this clock')])
            if operation is None:continue
            if operation=='rename':
                label=text_dialog('CLOCK LABEL',zones[action]['label'])
                if label:zones[action]['label']=label;atomic_json(TIMEZONE_FILE,zones)
                continue
            if operation=='delete':
                zones.pop(action);atomic_json(TIMEZONE_FILE,zones);continue
        zone=choose_menu('CHOOSE A TIMEZONE',[(z,z.replace('_',' ')) for z in sorted(available_timezones())],searchable=True)
        if zone is None:continue
        item={'label':zone.rsplit('/',1)[-1].replace('_',' '),'zone':zone}
        if action=='add':zones.append(item)
        else:zones[action]=item
        atomic_json(TIMEZONE_FILE,zones)


def edit_timezones_text():
    from zoneinfo import available_timezones
    while True:
        zones=load_timezones()
        print('\nTIMEZONES · Local time is always shown')
        for i,item in enumerate(zones):print(f"  {i+1}. {item['label']} — {item['zone']}")
        print('A Add · E Edit · D Delete · S Search zone names · Q Back')
        action=input('Action: ').strip().lower()
        if action in ('q',''):return
        if action=='s':
            query=input('City or region: ').strip().lower()
            print('\n'.join(z for z in sorted(available_timezones()) if query in z.lower()))
            continue
        try:
            if action not in ('a','e','d'):continue
            index=int(input('Timezone number: '))-1 if action in ('e','d') else None
            if index is not None and not 0<=index<len(zones):raise ValueError('Choose a listed number')
            if action=='d':zones.pop(index)
            else:
                old=zones[index] if index is not None else {}
                label=input(f"Label [{old.get('label','')}]: ").strip() or old.get('label','')
                zone=input(f"Timezone, e.g. Europe/Paris [{old.get('zone','')}]: ").strip() or old.get('zone','')
                ZoneInfo(zone)
                if not label:raise ValueError('Label required')
                item={'label':label,'zone':zone}
                if index is None:zones.append(item)
                else:zones[index]=item
            atomic_json(TIMEZONE_FILE,zones)
        except (ValueError,KeyError) as exc:print('Not saved:',exc)


def new_id():
    import uuid
    return uuid.uuid4().hex[:16]


def migrate_config(data):
    if data.get("version") == 2:
        return data
    grouped = {}
    for day, events in data["schedule"].items():
        for start, end, subject in events:
            key = (start, end, subject)
            if key not in grouped:
                # Stable IDs keep reminder deduplication consistent before first save.
                import hashlib
                grouped[key] = {"id": hashlib.sha256(repr(key).encode()).hexdigest()[:16],
                                "subject": subject, "start": start, "end": end, "days": [],
                                "from": "0001-01-01", "until": None,
                                "teacher": data.get("teachers", {}).get(subject, ""),
                                "url": data.get("links", DEFAULT_LINKS).get(subject, "")}
            grouped[key]["days"].append(DAYS.index(day))
    return {"version": 2, "series": list(grouped.values()), "exceptions": {}}


DEFAULT_CONFIG = migrate_config({"schedule": SCHEDULE, "teachers": TEACHERS})
DATA = DEFAULT_CONFIG


def valid_date(value):
    if not isinstance(value,str) or not re.fullmatch(r"\d{4}-\d{2}-\d{2}",value):
        raise ValueError("Use dates in YYYY-MM-DD format")
    return datetime.strptime(value, "%Y-%m-%d").date()


def validate_event(event):
    if not isinstance(event,dict):raise ValueError("Expected an event object")
    if event.get("kind","class") not in ("class","personal"):raise ValueError("Choose Class or Personal")
    if event.get("kind")=="personal" and (event.get("teacher") or event.get("url")):
        raise ValueError("Personal events cannot have teachers or meeting links")
    for key in ("id", "subject", "start", "end"):
        if not isinstance(event.get(key), str) or not event[key].strip():
            raise ValueError(f"Missing {key}")
    for key in ("start", "end"):
        if not re.fullmatch(r"(?:[01]\d|2[0-3]):[0-5]\d", event[key]):
            raise ValueError("Use HH:MM times (00:00–23:59)")
    if event["end"] <= event["start"]:
        raise ValueError("End time must follow start time")
    for key in ("subject", "teacher", "url"):
        value = event.get(key, "")
        if not isinstance(value, str) or any(ord(ch) < 32 or ord(ch) == 127 for ch in value):
            raise ValueError(f"Invalid {key}")
    url = event.get("url", "")
    if url:
        from urllib.parse import urlparse
        parsed = urlparse(url)
        if parsed.scheme != "https" or not parsed.netloc:
            raise ValueError("Meeting link must be an https URL")


def validate_config(data):
    if not isinstance(data, dict):
        raise ValueError("Expected a schedule object")
    data = migrate_config(data)
    if not isinstance(data.get("series"), list) or not isinstance(data.get("exceptions"), dict):
        raise ValueError("Invalid schedule format")
    for series in data["series"]:
        validate_event(series)
        if not isinstance(series.get("days"), list) or not series["days"] or any(
                type(d) is not int or d not in range(7 if series.get("kind")=="personal" else 5) for d in series["days"]):
            raise ValueError("Choose repeat days (classes use Monday–Friday)")
        first = valid_date(series["from"])
        if series.get("until") and valid_date(series["until"]) < first:
            raise ValueError("Invalid recurrence date range")
    for date, exceptions in data["exceptions"].items():
        valid_date(date)
        if not isinstance(exceptions, dict):
            raise ValueError("Invalid date exceptions")
        for identity, event in exceptions.items():
            if event is not None:
                validate_event(event)
                if event["id"] != identity:
                    raise ValueError("Exception ID mismatch")
    return data


def load_config():
    global DATA, TEACHERS, SCHEDULE, TIMETABLE
    import copy
    try:
        with open(CONFIG_FILE) as f:
            DATA = validate_config(json.load(f))
    except FileNotFoundError:
        DATA = copy.deepcopy(DEFAULT_CONFIG)
    except (OSError, ValueError, TypeError, KeyError) as exc:
        raise ValueError(f"Cannot load schedule: {exc}") from exc
    TEACHERS = {s["subject"]: s.get("teacher", "") for s in DATA["series"] if s.get("kind","class")=="class"}
    SCHEDULE = {}
    for day in DAYS:
        events = events_on(date_for_day(day))
        SCHEDULE[day] = [(e["start"], e["end"], e["subject"]) for e in events]
        TEACHERS.update({e["subject"]: e.get("teacher", "") for e in events if e.get("kind","class")=="class"})
    TIMETABLE = {day: [(e[2], "") for e in events] for day, events in SCHEDULE.items()}


def date_for_day(day, reference=None):
    date = reference or datetime.now().date()
    return date - timedelta(days=date.weekday()) + timedelta(days=DAYS.index(day))


def events_on(date, data=None):
    import copy
    data = DATA if data is None else data
    stamp = date.isoformat()
    events = {}
    for series in data["series"]:
        if (date.weekday() in series["days"] and series["from"] <= stamp
                and (not series.get("until") or stamp <= series["until"])):
            events[series["id"]] = copy.deepcopy(series)
    for identity, event in data["exceptions"].get(stamp, {}).items():
        if event is None:
            events.pop(identity, None)
        else:
            events[identity] = copy.deepcopy(event)
    return sorted(events.values(), key=lambda e: (e["start"], e["subject"]))


def save_config(data):
    atomic_json(CONFIG_FILE, validate_config(data))


def apply_event_edit(data, date, event, replacement, scope):
    """Edit a single occurrence, this and future occurrences, or the full series."""
    import copy
    data = copy.deepcopy(data)
    identity, stamp = event["id"], date.isoformat()
    if scope == "once":
        data["exceptions"].setdefault(stamp, {})[identity] = replacement
    elif scope in ("future", "all"):
        matches = [s for s in data["series"] if s["id"] == identity]
        if not matches:
            if scope == "future":
                raise ValueError("This is a one-off event; choose this occurrence only")
            data["exceptions"].setdefault(stamp, {})[identity] = replacement
        else:
            retained = []
            for series in data["series"]:
                if series["id"] != identity:
                    retained.append(series)
                elif scope == "future" and series["from"] < stamp:
                    series["until"] = min(series.get("until") or "9999-12-31",
                                          (date - timedelta(days=1)).isoformat())
                    retained.append(series)
            if replacement is not None:
                revised = copy.deepcopy(replacement)
                revised["from"] = stamp if scope == "future" else min(s["from"] for s in matches)
                revised["until"] = None
                revised.setdefault("days", event.get("days", [date.weekday()]))
                retained.append(revised)
            data["series"] = retained
            # An explicit series edit also replaces scoped one-off changes.
            for when, items in data["exceptions"].items():
                if scope == "all" or when >= stamp:
                    items.pop(identity, None)
    else:
        raise ValueError("Unknown edit scope")
    return validate_config(data)


def apply_subject_link(data, subject, url):
    """Update only meeting links for matching classes, including date overrides."""
    import copy
    result = copy.deepcopy(data)
    key = subject.strip().casefold()
    events = list(result['series'])
    events += [event for overrides in result['exceptions'].values()
               for event in overrides.values() if event is not None]
    for event in events:
        if event.get('kind', 'class') == 'class' and event['subject'].strip().casefold() == key:
            event['url'] = url.strip()
    return validate_config(result)


def ask_scope():
    value = input("Apply to [1] this occurrence only  [2] this and following  [3] all occurrences: ").strip()
    if value not in ("1", "2", "3"):
        raise ValueError("Choose 1, 2, or 3")
    return {"1": "once", "2": "future", "3": "all"}[value]


def edit_schedule_text(initial_date=None):
    import copy
    data = copy.deepcopy(DATA)
    date = initial_date or datetime.now().date()
    print("SCHEDULE EDITOR · S saves, Q cancels · blank fields keep their values")
    print("Series changes replace date-specific changes within the chosen scope.")
    try:
        while True:
            print(f"\n{date:%A %d %B %Y}")
            events = events_on(date, data)
            for i, event in enumerate(events, 1):
                print(f" {i}. {display_time(event['start'])}–{display_time(event['end'])}  {event['subject']}")
            if not events:
                print(" Nothing scheduled.")
            action = input("\n[A] Add  [E] Edit  [D] Delete  [R] Restore date  [G] Go to date  [S] Save  [Q] Cancel: ").strip().lower()
            try:
                if action == "q":
                    return
                if action == "s":
                    save_config(data)
                    load_config()
                    print("Saved. Dashboard, reminders, and widget use these changes.")
                    return
                if action == "g":
                    value = input("Date YYYY-MM-DD (Enter = today): ").strip()
                    date = valid_date(value) if value else datetime.now().date()
                    continue
                if action == "r":
                    data["exceptions"].pop(date.isoformat(), None)
                    print("Restored this date to its recurring schedule (save to keep).")
                    continue
                if action not in ("a", "e", "d"):
                    continue
                if action == "a":
                    old = {"id": new_id(), "subject": "", "start": "", "end": "", "teacher": "", "url": "", "days": [date.weekday()]}
                    repeat = input("[1] This date only  [2] Repeat weekly: ").strip()
                    if repeat not in ("1", "2"):
                        raise ValueError("Choose 1 or 2")
                    scope = "once" if repeat == "1" else "new"
                else:
                    index = int(input("Class number: ")) - 1
                    if not 0 <= index < len(events):
                        raise ValueError("Invalid class number")
                    old = events[index]
                    scope = ask_scope()
                if action == "d":
                    data = apply_event_edit(data, date, old, None, scope)
                    continue
                event = copy.deepcopy(old)
                kind=input(f"Type class/personal [{event.get('kind','class')}]: ").strip().lower() or event.get('kind','class')
                event['kind']=kind
                if kind=='personal':event.update(teacher='',url='')
                for key, label in (("subject", "Subject"), ("start", "Start HH:MM"), ("end", "End HH:MM"),
                                   ("teacher", "Teacher"), ("url", "Zoom link (- clears)")):
                    if kind=="personal" and key in ("teacher","url"):continue
                    current = event.get(key, "")
                    value = input(f"{label} [{current}]: ").strip()
                    if value:
                        event[key] = "" if value == "-" and key in ("url", "teacher") else value
                if scope != "once":
                    current = ",".join(str(d+1) for d in event.get("days", [date.weekday()]))
                    value = input(f"Repeat days 1=Mon ... 7=Sun (classes Mon–Fri) [{current}]: ").strip() or current
                    event["days"] = sorted(set(int(d.strip())-1 for d in value.split(",")))
                validate_event(event)
                if scope == "new":
                    candidate = copy.deepcopy(data)
                    event.update({"from": date.isoformat(), "until": None})
                    candidate["series"].append(event)
                    data = validate_config(candidate)
                else:
                    data = apply_event_edit(data, date, old, event, scope)
            except (ValueError, KeyError) as exc:
                print(f"Not changed: {exc}")
    except (KeyboardInterrupt, EOFError):
        print("\nCancelled; nothing saved.")


def event_form_rows(event, scope, new=False):
    rows=[('kind','Type'),('subject','Title')]
    if new:rows.append(('date','Date YYYY-MM-DD'))
    rows += [('start','Start HH:MM'),('end','End HH:MM'),('scope','Repeats' if new else 'Apply to')]
    if scope!='once':rows += [('days_preset','Repeat pattern')]+[('day'+str(i),DAYS[i].capitalize()) for i in range(7 if event.get('kind')=='personal' else 5)]
    if event.get('kind','class')=='class':rows += [('teacher','Teacher'),('url','Meeting link')]
    rows += [('save','Save event')]
    if not new:rows += [('delete','Delete event')]
    rows += [('cancel','Cancel')]
    return rows


def commit_event(data, date, old, event, scope, new=False, delete=False):
    import copy
    event=copy.deepcopy(event)
    if event.get('kind')=='personal':event.update(teacher='',url='')
    validate_event(event)
    if new:
        result=copy.deepcopy(data)
        if scope=='once':result['exceptions'].setdefault(date.isoformat(),{})[event['id']]=event
        elif scope=='new':
            event.update({'from':date.isoformat(),'until':None})
            result['series'].append(event)
        else:raise ValueError('Choose once or weekly for a new event')
        return validate_config(result)
    return apply_event_edit(data,date,old,None if delete else event,scope)


def edit_schedule(initial_date=None):
    """Mouse/keyboard editor with one form and explicit save, no prompt chain."""
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return edit_schedule_text(initial_date)
    import curses,copy
    def screen(win):
        curses.raw();curses.curs_set(0);win.keypad(True);curses.start_color();curses.use_default_colors()
        curses.mousemask(curses.ALL_MOUSE_EVENTS);curses.mouseinterval(0)
        nord_theme.curses_colors(curses,win,personal_role=nord_theme.options('classes')['classes_personal_color'])
        date=initial_date or datetime.now().date();selected=0;offset=0;message='';date_input=None;restore=False
        def put(y,text,style=0):
            h,w=win.getmaxyx()
            if 0<=y<h-1:
                try:win.addnstr(y,2,text,max(0,w-4),style)
                except curses.error:pass
        def keypress():
            try:return win.get_wch()
            except curses.error:return ''
        def click(key):
            if key!=curses.KEY_MOUSE:return None
            try:
                _,x,y,_,state=curses.getmouse()
                if state & curses.BUTTON4_PRESSED:return ('up',0)
                if state & getattr(curses,'BUTTON5_PRESSED',0):return ('down',0)
                if state & (curses.BUTTON1_PRESSED|curses.BUTTON1_CLICKED):return ('click',y)
            except curses.error:pass
            return None
        def form(old=None):
            new=old is None
            event=copy.deepcopy(old) if old else {'id':new_id(),'subject':'','kind':'class','start':'09:00','end':default_event_end(),'teacher':'','url':'','days':[date.weekday()]}
            event.setdefault('kind','class')
            stamp=date.isoformat();scope='once';focus=0;scroll=0;notice='';confirm=False;replace=True
