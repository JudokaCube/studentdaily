def default_event_index(events):
    seconds = now_seconds(None)
    return next((i for i,e in enumerate(events) if hm(e["end"])*60>seconds), 0)


def button_row(items, active=None):
    line, hits, column = "  ", [], 3
    for key, label in items:
        text = f" {key.upper()} {label} "
        palette=nord_theme.palette();bg=palette["surface"]
        style = "48;2;"+";".join(str(int(bg[i:i+2],16)) for i in (0,2,4))+";"+_fg(palette["accent"]) if key==active else ACCENT
        line += c(style, text) + " "
        hits.append((column,column+len(text)-1,key))
        column += len(text)+1
    return line,hits


def wrapped_buttons(items, width, active=None):
    # Compact buttons, centered independently; click coordinates follow the padding.
    rows=[];maps={};group=[];used=0
    def finish(group):
        texts=[f"{key.upper()} {label}" for key,label in group]
        length=sum(map(len,texts))+2*(len(texts)-1)
        padding=2+max(0,(width-length)//2)
        line=" "*padding;hits=[];column=padding+1
        palette=nord_theme.palette();bg=palette['surface']
        selected="48;2;"+';'.join(str(int(bg[i:i+2],16)) for i in (0,2,4))+";"+_fg(palette['accent'])
        for (key,label),text in zip(group,texts):
            line+=c(selected if key==active else ACCENT,text)+"  "
            hits.append((column,column+len(text)-1,key));column+=len(text)+2
        maps[len(rows)]=hits;rows.append(line.rstrip())
    for key,label in items:
        size=len(key)+len(label)+1
        if group and used+2+size>width:
            finish(group);group=[];used=0
        used+=size+(2 if group else 0);group.append((key,label))
    if group:finish(group)
    return rows,maps


def dashboard_header(now,date,view,cols,notice):
    import textwrap
    width=max(16,min(94,cols-4))
    left="STUDENTDAILY / "+date.strftime("%a %d %b").upper()
    if nord_theme.options("classes")["classes_week_numbers"]:left+=f" · W{date.isocalendar().week:02d}"
    clocks=timezone_text(now)
    if len(left)+len(clocks)+2<=width:
        rows=["  "+c(TEXT,left)+" "*(width-len(left)-len(clocks))+c(DIM,clocks)]
    else:
        rows=["  "+c(TEXT,left)]+["  "+c(DIM,line) for line in textwrap.wrap(clocks,width=width)]
    rows.append("  "+c(DIM,"─"*width));hits={}
    active={"day":"d","week":"w","tasks":"u","teachers":"r"}.get(view)
    for items,chosen in [([("d","Today"),("w","Week"),("u","To-do"),("r","Teachers"),("e","Schedule"),("i","Zones"),("f","Search"),("s","Data"),("y","Settings")],active),
                         ([(str(i+1),day[:3].title()) for i,day in enumerate(WEEKDAYS)]+[("g","Date")],str(date.weekday()+1) if view=="day" and date.weekday()<5 else None)]:
        buttons,maps=wrapped_buttons(items,width,chosen)
        hits.update({len(rows)+i:v for i,v in maps.items()});rows.extend(buttons)
    status=widget_status(now)
    rows += ["  "+c(NOW if notice else _fg(status["textColor"]),notice or status["text"]),""]
    return rows,hits


def dashboard_footer(view,cols):
    width=max(16,min(94,cols-4))
    actions=[("a","Add task"),("enter","Done"),("v","Edit"),("x","Delete"),("g","Date")] if view=="tasks" else [("z","Join"),("t","Timer"),("c","Countdown"),("o","Clock"),("a","Add task"),("m","Finish")]
    rows=["  "+c(DIM,"─"*width)];hits={}
    for items in (actions+[("h","Help"),("q","Quit")],):
        buttons,maps=wrapped_buttons(items,width)
        hits.update({len(rows)+i:[(a,b,"\r" if k=="enter" else k) for a,b,k in values] for i,values in maps.items()})
        rows.extend(buttons)
    return rows,hits


def hit_key(hits,x):
    return next((key for first,last,key in hits if first<=x<=last),None)


def task_summary(date):
    tasks=load_tasks().get(date.isoformat(),[])
    lines=[]
    for category in ("School","Life"):
        items=[t for t in tasks if t["category"]==category]
        done=sum(t["done"] for t in items)
        next_task=next((t["text"] for t in items if not t["done"]),"All clear" if items else "No tasks yet")
        lines.append(c(ACCENT,f"{category:<9}")+c(DIM,f"{done}/{len(items)} done   ")+c(TEXT,next_task))
    lines.append(c(DIM,"Click to open your to-do list · A to add a task"))
    return panel("YOUR DAY",lines).splitlines()


def dashboard():
    global UI_ACTIVE
    UI_ACTIVE = True
    view, date, query, offset = nord_theme.options("classes")["classes_start_view"], datetime.now().date(), "", 0
    follow_today, selected, notice = True, -1, ""
    sys.stdout.write("\033[?1049h\033[?25l"+BASE_STYLE+MOUSE_ON)
    try:
        while True:
            try:
                load_theme()
                reload_schedule()
            except ValueError as exc:
                notice = str(exc)
            now = datetime.now()
            if follow_today:
                date = now.date()
            events = events_on(date)
            targets, tasks = {}, []
            if view == "day":
                lines, targets = day_panel(date, selected)
                summary=task_summary(date) if nord_theme.options("classes")["classes_task_summary"] else []
                lines.append("")
                targets.update({len(lines)+row:("tasks_open",None) for row in range(len(summary))})
                lines.extend(summary)
            elif view == "week":
                lines = []
                monday = date-timedelta(days=date.weekday())
                for delta in range(7):
                    if delta>4 and not show_weekend(monday+timedelta(days=delta)):continue
                    part, hits = day_panel(monday+timedelta(days=delta))
                    targets.update({len(lines)+row: hit for row,hit in hits.items()})
                    lines.extend(part+[""])
            elif view == "tasks":
                lines, targets, tasks = task_panel(date, selected)
            elif view == "teachers":
                lines = render_teachers().splitlines()
            elif view == "find":
                lines = search_all(query)
            elif view == "help":
                lines = HELP_TEXT.splitlines()
            else:
                lines = build_output([view], None).strip("\n").splitlines()
            cols, rows = shutil.get_terminal_size((90,28))
            inset=max(0,(cols-98)//2)
            canvas_cols=min(cols,98)
            header,header_hits=dashboard_header(now,date,view,canvas_cols,notice)
            footer,footer_hits=dashboard_footer(view,canvas_cols)
            if cols<36 or rows<len(header)+len(footer)+4:
                sys.stdout.write("\033[H\033[2J"+clip_ansi("Window too small: enlarge it (Q quits).",max(1,cols-1)))
                sys.stdout.flush()
                with RawKeys() as keys:key=keys.read(.5)
                if (key or "").lower()=="q":break
                continue
            height = max(1,rows-len(header)-len(footer)-1)
            offset = min(max(0,offset),max(0,len(lines)-height))
            shown = lines[offset:offset+height]
            footer_start = len(header)+height
            if len(lines)>height:
                footer[-1] += f"  {offset+1}–{offset+len(shown)}/{len(lines)}"
            display = header+shown+[""]*(height-len(shown))+footer
            sys.stdout.write("\033[H"+BASE_STYLE)
            for line in display[:max(1,rows-1)]:
                sys.stdout.write(" "*inset+clip_ansi(line,max(1,cols-inset-1))+BASE_STYLE+"\033[K\n")
            sys.stdout.write("\033[J")
            sys.stdout.flush()
            with RawKeys() as keys:
                key = keys.read(1)
            if not key:
                continue
            mouse = parse_mouse(key)
            if mouse:
                button,x,y,state = mouse
                x-=inset
                if state == "m":
                    continue
                if button in (64,65):
                    offset += -3 if button==64 else 3
                    continue
                if button != 0:
                    continue
                if y-1 < len(header):
                    key=hit_key(header_hits.get(y-1,[]),x)
                    if not key:continue
                elif y-1 >= footer_start:
                    key=hit_key(footer_hits.get(y-1-footer_start,[]),x)
                    if not key:continue
                else:
                    target = targets.get(y-1-len(header)+offset)
                    if target:
                        kind,item = target
                        if kind == "event":
                            notice = open_event(item)
                            continue
                        elif kind == "task":
                            task_change(date,"toggle",item["id"])
                            continue
                        elif kind == "tasks_open":
                            key="u"
                        elif kind == "task_controls":
                            key = "a" if x < 18 else "\r" if x < 40 else "v" if x < 49 else "x"
                        elif kind == "task_date":
                            key = "g" if x < 24 else "\t"
                    else:
                        continue
            key = key.lower() if len(key)==1 else key
            if key=="q":
                break
            if key in (KEY_DOWN,"j","\x1b[6~"):
                offset += height if key=="\x1b[6~" else 1
                continue
            if key in (KEY_UP,"k","\x1b[5~"):
                offset -= height if key=="\x1b[5~" else 1
                continue
            if key=="\t":
                count = len(tasks) if view=="tasks" else len(events)
                selected = (selected+1)%count if count else -1
                for row, (_,item) in targets.items():
                    choices = tasks if view=="tasks" else events
                    if item is not None and 0<=selected<len(choices) and item["id"]==choices[selected]["id"]:
                        if row<offset: offset=row
                        elif row>=offset+height: offset=row-height+1
                        break
                continue
            if key=="m" and events:
                index=selected if 0<=selected<len(events) else default_event_index(events)
                event=events[index]
                if date==now.date() and hm(event['start'])*60<=now_seconds(None):
                    done=toggle_finished(event,date)
                    notice="Marked finished. Press M on this event to undo." if done else "Event restored."
                else:notice="Finish is available once an event has started today."
                continue
            if key in ("\r","\n","z"):
                if view=="tasks" and key!="z":
                    if tasks:
                        task_change(date,"toggle",tasks[max(0,selected)%len(tasks)]["id"])
                elif events:
                    index = selected if 0<=selected<len(events) else default_event_index(events)
                    notice = open_event(events[index])
                else:
                    notice = "Nothing to join on this date."
                continue
            offset,notice = 0,""
            if key in "12345" and len(key)==1:
                date = date_for_day(DAYS[int(key)-1],date)
                view,follow_today,selected = "day",False,-1
            elif key=="d":
                view,follow_today,selected = "day",True,-1
            elif key in ("w","u","r","h","?","n","l","b"):
                view = {"w":"week","u":"tasks","r":"teachers","h":"help","?":"help","n":"now","l":"left","b":"free"}[key]
                selected=-1
            elif key in ("e","t","f","c","o","p","a","x","v","g","i","s","y"):
                sys.stdout.write(MOUSE_OFF+"\033[2J\033[H\033[?25h"+BASE_STYLE)
                try:
                    if key=="s":
                        data_menu()
                    elif key=="y":
                        nord_theme.settings("classes")
                        load_theme()
                    elif key=="i":
                        edit_timezones()
                    elif key=="e":
                        edit_schedule(date)
                    elif key=="g":
                        value=input("Date YYYY-MM-DD (Enter = today): ").strip()
                        date=valid_date(value) if value else now.date()
                        follow_today=False
                        selected=-1
                    elif key=="a":
                        category=choose_menu("NEW TASK",[("s","School"),("l","Life")])
                        if category in ("s","l"):
                            text=text_dialog("NEW TASK")
                            if text:task_change(date,"add",text=text,category="School" if category=="s" else "Life")
                        view="tasks"
                    elif key in ("x","v") and view=="tasks" and tasks:
                        task=tasks[max(0,selected)%len(tasks)]
                        if key=="x":
                            if choose_menu("DELETE TASK?",[("cancel","Keep task"),("delete","Delete",task["text"])])=="delete":
                                task_change(date,"delete",task["id"])
                        else:
                            text=text_dialog("EDIT TASK",task["text"])
                            if text:task_change(date,"edit",task["id"],text=text)
                    elif key=="t":
                        duration=input("Timer duration (minutes or 1h30m; Enter cancels): ").strip()
                        if duration:timer_loop(duration)
                    elif key=="f":
                        query=input("Search classes, teachers and tasks: ").strip()
                        view="find" if query else "day"
                    elif key=="c":timer_loop("class")
                    elif key=="o":clock_loop()
                    elif key=="p":pin(1)
                except (KeyboardInterrupt,EOFError):
                    pass
                except (ValueError,OSError) as exc:
                    notice=str(exc)
                if key in ("y","e","i","s","a","x","v"):sys.stdout.write("\033[?1049h")
                sys.stdout.write("\033[?25l\033[2J\033[H"+BASE_STYLE+MOUSE_ON)
    except (KeyboardInterrupt,EOFError):
        pass
    finally:
        UI_ACTIVE=False
        sys.stdout.write(MOUSE_OFF+"\033[0m\033[?25h\033[?1049l")
        sys.stdout.flush()


def main():
    argv = sys.argv[1:]
    if argv == ["--version"]:
        print("StudentDaily "+nord_theme.VERSION);return
    if argv == ["settings"]:
        nord_theme.settings("classes")
        return
    if argv == ["theme"]:
        nord_theme.picker()
        return
    if argv == ["data"]:
        data_menu()
        return
    if argv == ["timezones"]:
        edit_timezones()
        return
    if argv == ["reload"]:
        nord_theme.reload_widgets()
        pin(1)
        return
    if any(a in argv for a in ("--help", "-h", "help")):
        print(HELP_TEXT)
        return
    if argv and argv[0] == "status":
        if "--waybar" in argv:
            print(json.dumps(nord_theme.waybar_status(widget_status(),"classes")))
            return
        print(json.dumps(widget_status()) if "--json" in argv else widget_status()["text"])
        return
    if "--reminder-daemon" in argv or "--notify-check" in argv:
        reminder_daemon(once="--notify-check" in argv)
        return

    positional = [a for a in argv if not a.startswith("-")]
    arg = positional[0] if positional else None

    if arg == "tasks":
        print("\n".join(task_panel(datetime.now().date())[0]))
        return

    if arg == "edit":
        edit_schedule()
        return

    if arg == "pin":
        pin(parse_interval(argv))
        return

    if arg == "clock":
        clock_loop()
        return

    if arg == "timer":
        timer_loop(positional[1] if len(positional) > 1 else None)
        return

    if arg in (None, "menu") and sys.stdin.isatty() and sys.stdout.isatty():
        dashboard()
        return

    if arg == "watch":
        watch_loop(parse_interval(argv))
        return

    at = parse_at(argv)
    print(build_output(positional, at))


if __name__ == "__main__":
    main()
