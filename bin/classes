def load_tasks():
    try:
        with open(TASK_FILE) as f:
            data = json.load(f)
        if not isinstance(data, dict):
            raise ValueError("Invalid task file")
        return data
    except FileNotFoundError:
        return {}


def task_change(date, action, identity=None, text=None, category="School"):
    # Serialize edits across dashboard windows without merging away other days.
    import fcntl
    os.makedirs(os.path.dirname(TASK_FILE), exist_ok=True)
    with open(TASK_FILE + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = load_tasks()
        items = data.setdefault(date.isoformat(), [])
        if action == "add":
            if category not in ("School", "Life") or not text or not text.strip():
                raise ValueError("A task needs a category and text")
            items.append({"id": new_id(), "text": text.strip(), "category": category, "done": False})
        else:
            task = next((t for t in items if t["id"] == identity), None)
            if task is None:
                return
            if action == "toggle":
                task["done"] = not task["done"]
            elif action == "delete":
                items.remove(task)
            elif action == "edit" and text and text.strip():
                task["text"] = text.strip()
        atomic_json(TASK_FILE, data)


def search_all(query):
    query=query.casefold().strip()
    if not query:return ['Type an event, teacher, task or date.']
    results=[]
    for item in DATA['series']:
        if query in ' '.join(str(item.get(k,'')) for k in ('subject','teacher','start','end')).casefold():
            days=', '.join(DAYS[d][:3].title() for d in item['days'])
            results.append(f"{'PERSONAL' if item.get('kind')=='personal' else 'CLASS'}   {item['subject']} · {item.get('teacher','')} · {days} {display_time(item['start'])}–{display_time(item['end'])}")
    for date,changes in DATA['exceptions'].items():
        for item in changes.values():
            if item and query in (date+' '+item['subject']+' '+item.get('teacher','')).casefold():
                results.append(f"CHANGED {date} · {item['subject']} · {item.get('teacher','')} · {display_time(item['start'])}")
    for date,tasks in sorted(load_tasks().items()):
        for task in tasks:
            if query in (date+' '+task['text']+' '+task['category']).casefold():
                results.append(f"TASK    {date} · {task['category']} · {'✓' if task['done'] else '□'} {task['text']}")
    return results or ['No matching events, teachers or tasks.']


def export_bundle(path):
    load_config()
    atomic_json(str(path),{'format':'nord-classes','version':1,'schedule':DATA,
                         'timezones':load_timezones(),'tasks':load_tasks(),'completed':load_completed(),'theme':nord_theme.current()})


def validate_bundle(data):
    if not isinstance(data,dict):raise ValueError('Expected a data object')
    if data.get('format','nord-classes')!='nord-classes' or data.get('version',1)!=1:raise ValueError('Unsupported export format')
    validate_config(data['schedule'])
    zones=data.get('timezones',[])
    if not isinstance(zones,list):raise ValueError('Invalid timezones')
    for zone in zones:
        if not isinstance(zone.get('label'),str) or not zone['label'].strip():raise ValueError('Timezone label required')
        ZoneInfo(zone['zone'])
    tasks=data.get('tasks',{})
    if not isinstance(tasks,dict):raise ValueError('Invalid tasks')
    for date,items in tasks.items():
        valid_date(date)
        if not isinstance(items,list):raise ValueError('Invalid task list')
        for task in items:
            if not isinstance(task,dict) or not isinstance(task.get('id'),str) or not task['id'] or not isinstance(task.get('text'),str) or not task['text'] or task.get('category') not in ('School','Life') or type(task.get('done')) is not bool:raise ValueError('Invalid task')
    completed=data.get('completed',{})
    if not isinstance(completed,dict):raise ValueError('Invalid completion data')
    for date,keys in completed.items():
        valid_date(date)
        if not isinstance(keys,list) or any(not isinstance(k,str) for k in keys):raise ValueError('Invalid completion entries')
    if data.get('theme','Nord') not in nord_theme.THEMES:raise ValueError('Unknown theme')
    return data


def import_bundle(path,mode='merge'):
    import copy
    from pathlib import Path
    try:incoming=validate_bundle(json.loads(Path(path).read_text()))
    except (KeyError,TypeError,AttributeError) as exc:raise ValueError('Invalid import file: '+str(exc)) from exc
    if mode not in ('merge','replace'):raise ValueError('Choose merge or replace')
    if mode=='replace':schedule=copy.deepcopy(incoming['schedule']);tasks=incoming.get('tasks',{});zones=incoming.get('timezones',[])
    else:
        load_config();schedule=copy.deepcopy(DATA)
        incoming_ids={s['id'] for s in incoming['schedule']['series']}
        schedule['series']=[s for s in schedule['series'] if s['id'] not in incoming_ids]+copy.deepcopy(incoming['schedule']['series'])
        for date,changes in incoming['schedule']['exceptions'].items():schedule['exceptions'].setdefault(date,{}).update(changes)
        tasks=load_tasks()
        for date,items in incoming.get('tasks',{}).items():
            combined={t['id']:t for t in tasks.get(date,[])};combined.update({t['id']:t for t in items});tasks[date]=list(combined.values())
        combined={z['zone']:z for z in load_timezones()};combined.update({z['zone']:z for z in incoming.get('timezones',[])});zones=list(combined.values())
    validate_config(schedule)
    completed={} if mode=='replace' else load_completed()
    for date,keys in incoming.get('completed',{}).items():completed[date]=sorted(set(completed.get(date,[]))|set(keys))
    writes={CONFIG_FILE:schedule,TASK_FILE:tasks,TIMEZONE_FILE:zones,completion_file():completed}
    if 'theme' in incoming:writes[str(nord_theme.SETTINGS)]={'theme':incoming['theme']}
    previous={path:Path(path).read_bytes() if Path(path).exists() else None for path in writes}
    try:
        for path,value in writes.items():atomic_json(path,value)
    except Exception:
        for path,content in previous.items():
            if content is None:Path(path).unlink(missing_ok=True)
            else:atomic_json(path,json.loads(content))
        raise
    load_config();load_theme()


def data_menu():
    if not sys.stdin.isatty() or not sys.stdout.isatty():return data_menu_text()
    while True:
        action=choose_menu('STUDENTDAILY / DATA',[
            ('export','Export to a JSON file','Includes events, teachers, links, tasks, clocks and theme.'),
            ('import','Import from a JSON file','Merge with your data or replace it.')])
        if action is None:return
        value=text_dialog('EXPORT FILE' if action=='export' else 'IMPORT FILE', '~/Downloads/studentdaily-export.json' if action=='export' else '', 'Full file path · ~ means your home folder')
        if not value:continue
        path=Path(value).expanduser()
        try:
            if action=='export':
                if path.exists() and choose_menu('FILE ALREADY EXISTS',[('cancel','Cancel'),('replace','Replace this export file')])!='replace':continue
                export_bundle(path);notice='Export saved: '+str(path)
            else:
                mode=choose_menu('HOW SHOULD DATA BE IMPORTED?', [('merge','Merge with current data','Retains other existing entries; matching IDs are updated.'),('replace','Replace current data','Replaces the data categories present in the file.')])
                if mode is None:continue
                if mode=='replace' and choose_menu('REPLACE EXISTING DATA?', [('cancel','Cancel'),('replace','Replace with this file')])!='replace':continue
                import_bundle(path,mode);notice='Import complete.'
        except (ValueError,OSError,KeyError,TypeError) as exc:notice='Could not complete: '+str(exc)
        choose_menu('STUDENTDAILY / DATA', [('back','Back',notice)])


def data_menu_text():
    from pathlib import Path
    print('STUDENTDAILY DATA · schedule, teachers, meeting links, tasks, timezones and theme')
    action=input('[E] Export  [I] Import  [Enter] Back: ').strip().lower()
    if action=='e':
        value=input('Export JSON path [~/Downloads/classes-export.json]: ').strip() or '~/Downloads/classes-export.json'
        path=Path(value).expanduser()
        if path.exists() and input('Replace this existing export? [y/N]: ').lower()!='y':return
        export_bundle(path);print('Exported:',path)
    elif action=='i':
        value=input('Import JSON path (Enter cancels): ').strip()
        if not value:return
        mode=input('[M] Merge with current data (default) / [R] Replace current data: ').strip().lower()
        if mode=='r' and input('Replace current StudentDaily data with the file? [y/N]: ').lower()!='y':return
        import_bundle(Path(value).expanduser(),'replace' if mode=='r' else 'merge');print('Import complete.')
    else:return
    input('Press Enter to return…')


def open_event(event):
    if event.get("kind")=="personal":return "Personal event · "+event["subject"]
    url = event.get("url", "").strip()
    if not url:
        return "No Zoom link saved for this class. Add one in Edit."
    validate_event(event)
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    return f"Opening {event['subject']}…"


