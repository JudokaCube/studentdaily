{
  "custom/studentdaily": {
    "exec": "\"$HOME/.local/bin/classes\" status --waybar",
    "return-type": "json",
    "interval": 10,
    "signal": 8,
    "format": "{text}",
    "tooltip": true,
    "on-click": "\"$HOME/.local/bin/classes\" pin",
    "on-click-right": "\"$HOME/.local/bin/classes\" reload"
  }
}
